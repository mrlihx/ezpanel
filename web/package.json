{
  "name": "ezpanel-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "postinstall": "node --input-type=module -e \"import {writeFileSync} from 'node:fs'; writeFileSync('node_modules/go.mod', 'module ezpanel/frontend-dependencies\\n');\""
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.107.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "antd": "5.29.3",
    "axios": "1.21.1",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "yaml": "2.9.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "dompurify": "3.4.18",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
